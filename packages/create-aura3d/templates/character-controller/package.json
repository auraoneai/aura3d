{
  "name": "aura3d-character-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "enable:physics": "npm install @aura3d/physics@4.6.1 @aura3d/physics-rapier@4.6.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node -e \"console.log('Browser specs run on a remote runner, not on this machine. On the remote runner run: npm run test:browser (AuraOne repos: tools/remote-acr/run.sh). Local checks: npm run typecheck && npm run build.')\" && npm run typecheck",
    "test:browser": "playwright test tests/route-health.spec.ts tests/screenshot.spec.ts tests/certified-rig.spec.ts --workers=1"
  },
  "dependencies": {
    "@aura3d/animation": "4.6.1",
    "@aura3d/engine": "4.6.1",
    "@aura3d/assets": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
