{
  "name": "@aura3d/assets",
  "version": "5.0.3",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser-index.d.ts",
        "default": "./dist/browser-index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser-index.d.ts",
      "import": "./dist/browser-index.js"
    },
    "./gltf-runtime": {
      "types": "./dist/gltf-runtime.d.ts",
      "import": "./dist/gltf-runtime.js"
    },
    "./vite": {
      "types": "./dist/vite/auraDecoders.d.ts",
      "import": "./dist/vite/auraDecoders.js"
    },
    "./vite-client": {
      "types": "./vite-client.d.ts",
      "import": "./vite-client.js"
    },
    "./exporters": {
      "types": "./dist/exporters/index.d.ts",
      "browser": "./dist/exporters/index.js",
      "import": "./dist/exporters/index.js",
      "default": "./dist/exporters/index.js"
    },
    "./importers": {
      "types": "./dist/importers.d.ts",
      "browser": "./dist/importers.js",
      "import": "./dist/importers.js",
      "default": "./dist/importers.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@aura3d/animation": "workspace:*",
    "@aura3d/rendering": "workspace:*",
    "@aura3d/scene": "workspace:*",
    "draco3d": "1.5.7",
    "ktx-parse": "1.0.1",
    "meshoptimizer": "1.2.0"
  },
  "sideEffects": [
    "./src/workers/ktx2.worker.ts",
    "./src/workers/zstd.worker.ts",
    "./dist/workers/ktx2.worker.js",
    "./dist/workers/zstd.worker.js"
  ],
  "description": "Asset identity, loading, caching, dependency tracking, import pipelines, worker job boundaries, and GLB/glTF runtime loaders for Aura3D.",
  "keywords": [
    "aura3d",
    "3d",
    "browser-3d",
    "web-3d",
    "typescript",
    "assets",
    "asset-loader",
    "gltf",
    "glb",
    "texture-loader",
    "asset-cache",
    "import-pipeline",
    "typed-assets"
  ],
  "homepage": "https://aura3d.auraone.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/aura3d.git",
    "directory": "packages/assets"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/aura3d/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist",
    "vendor",
    "vite-client.d.ts",
    "vite-client.js"
  ]
}
