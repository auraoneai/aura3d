{
  "name": "@aura3d/engine-runtime",
  "version": "2.0.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced-runtime": {
      "types": "./dist/advanced-runtime/index.d.ts",
      "import": "./dist/advanced-runtime/index.js"
    },
    "./animation-studio": {
      "types": "./dist/animation-studio/index.d.ts",
      "import": "./dist/animation-studio/index.js"
    },
    "./production-runtime": {
      "types": "./dist/production-runtime/index.d.ts",
      "import": "./dist/production-runtime/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./lanes": {
      "types": "./dist/lanes/index.d.ts",
      "import": "./dist/lanes/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@aura3d/animation": "workspace:*",
    "@aura3d/apps": "workspace:*",
    "@aura3d/assets": "workspace:*",
    "@aura3d/audio": "workspace:*",
    "@aura3d/core": "workspace:*",
    "@aura3d/ecs": "workspace:*",
    "@aura3d/editor-runtime": "workspace:*",
    "@aura3d/input": "workspace:*",
    "@aura3d/physics": "workspace:*",
    "@aura3d/product-studio": "workspace:*",
    "@aura3d/rendering": "workspace:*",
    "@aura3d/scene": "workspace:*",
    "@aura3d/scripting": "workspace:*",
    "@aura3d/workflows": "workspace:*"
  },
  "sideEffects": [
    "./src/lanes/**/*.ts",
    "./src/agent-api/compiler/diagnosticOnly.*.ts",
    "./src/agent-api/compiler/optionCoverage.ts",
    "./src/agent-api/feel/lint/evidenceOnlyFeel.ts",
    "./src/agent-api/looks/lookLint.ts",
    "./dist/lanes/**/*.js",
    "./dist/agent-api/compiler/diagnosticOnly.*.js",
    "./dist/agent-api/compiler/optionCoverage.js",
    "./dist/agent-api/feel/lint/evidenceOnlyFeel.js",
    "./dist/agent-api/looks/lookLint.js"
  ],
  "peerDependencies": {
    "@aura3d/navigation-recast": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@aura3d/navigation-recast": {
      "optional": true
    }
  }
}
