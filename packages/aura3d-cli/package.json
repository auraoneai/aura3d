{
  "name": "@aura3d/cli",
  "version": "1.5.2",
  "type": "module",
  "bin": {
    "aura3d": "dist/cli.js",
    "aura": "dist/cli.js",
    "cli": "dist/cli.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
