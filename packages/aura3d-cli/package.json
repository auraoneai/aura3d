    "glb",
    "gltf-assets",
    "glb-assets",
    "typed-assets",
    "asset-pipeline",
    "asset-validation",
    "asset-provenance",
    "asset-search",
    "game-assets",
    "animation-assets",
    "character-assembly",
    "ai-agents",
    "coding-agents",
    "vite",
    "static-deploy",
    "diagnostics",
    "screenshot-testing"
  ],
  "homepage": "https://aura3d.auraone.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/aura3d.git",
    "directory": "packages/aura3d-cli"
  },
