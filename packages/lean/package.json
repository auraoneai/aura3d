{
  "name": "@aura3d/lean",
  "version": "2.0.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js"
    },
    "./game": {
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js"
    }
  },
  "dependencies": {
    "@aura3d/assets": "workspace:*",
    "@aura3d/rendering": "workspace:*",
    "@aura3d/scene": "workspace:*"
  },
  "description": "Lean Aura3D browser runtime for production rendering, typed glTF products, and deterministic arcade games without physics, navigation, editor, or Node media dependencies.",
  "keywords": [
    "aura3d",
    "browser-3d",
    "webgl2",
    "gltf",
    "typescript",
    "game-runtime"
  ],
  "homepage": "https://aura3d.auraone.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/aura3d.git",
    "directory": "packages/lean"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/aura3d/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist"
  ]
}
