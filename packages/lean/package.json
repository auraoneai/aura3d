{
  "name": "@aura3d/lean",
  "version": "3.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/product.js"
    },
    "./game": {
      "types": "./dist/game.d.ts",
      "import": "./dist/game.js"
    }
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*"
  },
  "description": "Deprecated re-export shim of @aura3d/engine (PRD-15 §7.5). Removed in 4.0.0 — import @aura3d/engine instead.",
  "keywords": [
    "aura3d",
    "browser-3d",
    "webgl2",
    "gltf",
    "typescript",
    "game-runtime"
  ],
  "homepage": "https://aura3d.auraone.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auraoneai/aura3d.git",
    "directory": "packages/lean"
  },
  "bugs": {
    "url": "https://github.com/auraoneai/aura3d/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "dist"
  ]
}
