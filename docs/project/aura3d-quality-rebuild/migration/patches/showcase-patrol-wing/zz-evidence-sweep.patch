-  addXCap(fuselage, bodyRings[0], 1.52, true);
-  addXCap(fuselage, bodyRings.at(-1), -1.38, false);
-
-  const canopy = part();
-  addExtrudedPolygonXZ(canopy, [[0.72, -0.2], [0.7, 0.2], [-0.18, 0.23], [-0.46, 0.16], [-0.46, -0.16], [-0.18, -0.23]], 0.18, 0.4);
