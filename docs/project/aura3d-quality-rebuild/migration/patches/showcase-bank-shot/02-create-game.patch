Subject: [PATCH 1/5] migration(showcase-bank-shot) step 2: mount via
 @aura3d/game createGame

createGameApp -> createGame; pause key removed from input actions (session lifecycle owns pause keys); @aura3d/game dep added.

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-bank-shot/package.json |  3 ++-
 apps/showcase-bank-shot/src/legacy/main.ts  | 15 +++++++++------
 2 files changed, 11 insertions(+), 7 deletions(-)

diff --git a/apps/showcase-bank-shot/package.json b/apps/showcase-bank-shot/package.json
index 733b39e8..ac43b1bb 100644
--- a/apps/showcase-bank-shot/package.json
+++ b/apps/showcase-bank-shot/package.json
@@ -17,7 +17,8 @@
     "write:route-health": "node scripts/write-route-health.mjs"
   },
   "dependencies": {
-    "@aura3d/engine": "workspace:*"
+    "@aura3d/engine": "workspace:*",
+    "@aura3d/game": "workspace:*"
   },
   "devDependencies": {
     "typescript": "^5.8.3",
diff --git a/apps/showcase-bank-shot/src/legacy/main.ts b/apps/showcase-bank-shot/src/legacy/main.ts
index ea85a817..49e310f3 100644
--- a/apps/showcase-bank-shot/src/legacy/main.ts
+++ b/apps/showcase-bank-shot/src/legacy/main.ts
@@ -12,7 +12,6 @@
  */
 import {
   camera,
-  createGameApp,
   effects,
   game,
   lights,
@@ -25,6 +24,7 @@ import {
   type AuraSceneNode,
   type AuraDiagnostics
 } from "@aura3d/engine";
+import { createGame } from "@aura3d/game";
 import { assets } from "../../../src/aura-assets";
 import { CueController, AIM_STEP, SPIN_STEP } from "./cue";
 import { RulesEngine, type ShotRecord, type ShotOutcome } from "./rules";
@@ -368,7 +368,10 @@ function buildScene(): ReturnType<typeof scene> {
 }
 
 // ---------------------------------------------------------------- mount ------
-const gameApp = createGameApp("#app", {
+const bankGame = createGame({
+  id: "showcase-bank-shot",
+  target: "#app",
+  scene: buildScene,
   diagnostics: { overlay: false, performancePanel: false },
   physics: {
     seed: 20260905,
@@ -381,7 +384,6 @@ const gameApp = createGameApp("#app", {
       spinTop: ["KeyW", "ArrowUp"],
       spinDraw: ["KeyS", "ArrowDown"],
       charge: ["Space"],
-      pause: ["KeyP", "Escape"],
       reset: ["KeyR"]
     },
     bufferMs: 80,
@@ -389,11 +391,12 @@ const gameApp = createGameApp("#app", {
     touch: true
   },
   loop: { fixedDt: 1 / 60, maxSubSteps: 2 },
-  scene: buildScene()
+  qualityRebuild: { flags: ["game"] }
 });
-const app = gameApp.app;
-const input = gameApp.input!;
+const app = bankGame.app;
+const input = bankGame.input!;
 if (!input) throw new Error("Bank Shot failed to create Aura3D input.");
+bankGame.start();
 
 const ballHandles = new Map<string, AuraRuntimeNodeHandle>();
 const ballShadowHandles = new Map<string, AuraRuntimeNodeHandle>();
