-/** Classic 8-ball hues: balls 1-7 solids, 8 black, 9-15 stripes of the same hues. */
-const BALL_HUES = {
-  1: [0.99, 0.82, 0.09],
-  2: [0.10, 0.28, 0.75],
-  3: [0.85, 0.12, 0.10],
