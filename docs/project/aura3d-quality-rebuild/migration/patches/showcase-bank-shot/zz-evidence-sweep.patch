-};
-const BALL_WHITE = [0.93, 0.93, 0.9, 1];
-const BALL_BLACK = [0.05, 0.05, 0.06, 1];
-const BALL_SHININESS = {
-  roughness: 0.055,
-  metallic: 0,
-  clearcoat: 0.94,
-  clearcoatRoughness: 0.042,
-  specular: 0.96
-};
