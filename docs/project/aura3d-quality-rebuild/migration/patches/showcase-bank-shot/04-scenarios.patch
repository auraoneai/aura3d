diff --git a/apps/showcase-bank-shot/src/scenario-drive.ts b/apps/showcase-bank-shot/src/scenario-drive.ts
new file mode 100644
index 00000000..b2194101
--- /dev/null
+++ b/apps/showcase-bank-shot/src/scenario-drive.ts
@@ -0,0 +1,35 @@
+/**
+ * scenario-drive.ts — gameplay-only surface the `src/scenarios/` modules use.
+ * Bound once from `main.ts` after `rules`/`sim` exist; scenario files never
+ * reach for route internals directly.
+ */
+import type { ShotOutcome, ShotRecord } from "./rules";
+
+export interface BankShotDrive {
+  resetForFixture(): void;
+  resolve(record: ShotRecord): ShotOutcome;
+  advanceRack(): void;
+  toast(text: string): void;
+  sync(): void;
+}
+
+let active: BankShotDrive | undefined;
+
+export function bindBankShotDrive(impl: BankShotDrive): void {
+  active = impl;
+}
+
+function bound(): BankShotDrive {
+  if (active === undefined) {
+    throw new Error("Bank Shot scenario drive is not bound yet — call createGame first.");
+  }
+  return active;
+}
+
+export const drive: BankShotDrive = {
+  resetForFixture: () => bound().resetForFixture(),
+  resolve: (record) => bound().resolve(record),
+  advanceRack: () => bound().advanceRack(),
+  toast: (text) => bound().toast(text),
+  sync: () => bound().sync()
+};
diff --git a/apps/showcase-bank-shot/src/scenarios/eight-finish.ts b/apps/showcase-bank-shot/src/scenarios/eight-finish.ts
new file mode 100644
index 00000000..8d252891
--- /dev/null
+++ b/apps/showcase-bank-shot/src/scenarios/eight-finish.ts
@@ -0,0 +1,16 @@
+import type { GameScenario } from "@aura3d/engine/contracts";
+import { drive } from "../scenario-drive";
+import { RACK_COUNT } from "../racks";
+
+export const eightFinish: GameScenario = {
+  description: "every rack cleared: solids then the eight",
+  setup() {
+    drive.resetForFixture();
+    for (let rack = 1; rack <= RACK_COUNT; rack += 1) {
+      drive.resolve({ firstContact: 1, cushionAfterContact: true, potted: [1, 2, 3, 4, 5, 6, 7] });
+      drive.resolve({ firstContact: 8, cushionAfterContact: true, potted: [8] });
+      if (rack < RACK_COUNT) drive.advanceRack();
+    }
+    drive.sync();
+  }
+};
