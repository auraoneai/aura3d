From 716340fb4be0f3e79f59a92b9019e7c0b7c1a050 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:35:45 +0000
Subject: [PATCH] [QR-09] pulse-tunnel: createAuraApp -> createGame

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-pulse-tunnel/src/legacy/main.ts | 27 +++++++++++++++-----------
 1 file changed, 16 insertions(+), 11 deletions(-)

diff --git a/apps/showcase-pulse-tunnel/src/legacy/main.ts b/apps/showcase-pulse-tunnel/src/legacy/main.ts
index 0245e881..9fe389e3 100644
--- a/apps/showcase-pulse-tunnel/src/legacy/main.ts
+++ b/apps/showcase-pulse-tunnel/src/legacy/main.ts
@@ -10,7 +10,6 @@
  */
 import {
   camera,
-  createAuraApp,
   effects,
   game,
   lights,
@@ -22,6 +21,7 @@ import {
   type AuraMaterialSpec,
   type RuntimeNodeHandleLike
 } from "@aura3d/engine";
+import { createGame } from "@aura3d/game";
 import { assets } from "../../../src/aura-assets";
 import {
   PULSE_DRIFT_CHECKS_TO_FLIP,
@@ -1366,8 +1366,17 @@ const tunnelBackdrop = prefabs.neonTunnel({ rings: 8 }).filter((node) => {
   return !name.includes("true circular neon tunnel tube ring");
 });
 
-const app = createAuraApp("#app", {
-  scene: scene()
+const pulseGame = createGame({
+  id: "showcase-pulse-tunnel",
+  target: "#app",
+  scene: () => pulseScene,
+  physics: {
+    seed: 20260912,
+    continuousCollision: { mode: "adaptive-substeps", maxSubSteps: 4 }
+  },
+  qualityRebuild: { flags: ["game"] }
+});
+const pulseScene = scene()
     .background(visualReviewCapture ? "#171a38" : "#180b28")
     .addMany([
       ...(visualReviewCapture ? [] : tunnelBackdrop),
@@ -1588,14 +1597,10 @@ const app = createAuraApp("#app", {
     ])
     .camera(camera.perspective(visualReviewCapture
       ? { position: [0.10, 2.72, 6.55], target: [0.02, 0.92, -2.02], fov: 47 }
-      : { position: [0, 0.72, 3.8], target: [0, 0.32, -8], fov: 50 })),
-  physics: {
-    seed: 20260912,
-    continuousCollision: { mode: "adaptive-substeps", maxSubSteps: 4 }
-  },
-  diagnostics: false,
-  autoStart: true
-});
+      : { position: [0, 0.72, 3.8], target: [0, 0.32, -8], fov: 50 }));
+
+const app = pulseGame.app;
+pulseGame.start();
 
 // ---- runtime handles ---------------------------------------------------------
 
