From a50566ceb071dd13bbe8f0aaa890585825d4b453 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:38:46 +0000
Subject: [PATCH] [QR-09] pulse-tunnel: paused flag -> game.session

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-pulse-tunnel/src/legacy/main.ts | 20 ++++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/apps/showcase-pulse-tunnel/src/legacy/main.ts b/apps/showcase-pulse-tunnel/src/legacy/main.ts
index f1bf3e2d..ed4a1a41 100644
--- a/apps/showcase-pulse-tunnel/src/legacy/main.ts
+++ b/apps/showcase-pulse-tunnel/src/legacy/main.ts
@@ -1039,7 +1039,6 @@ Object.defineProperty(window, "__PULSE_TUNNEL_TEST__", {
 const hudElements = setupPulseHud(document.getElementById("panel"));
 const debugHud = isPulseDebugMode();
 let runState: RunState = "ready";
-let paused = false;
 let fogPulseRemaining = 0;
 let hitFlashRemaining = 0;
 let runStartPending = false;
@@ -1123,7 +1122,7 @@ function restart(): void {
   fogPulseRemaining = 0;
   hitFlashRemaining = 0;
   lastSection = "intro";
-  paused = false;
+  pulseGame.session.resume();
   runState = "ready";
   tunnelAudio.stopStems();
   applySection("intro", false);
@@ -1211,12 +1210,17 @@ app.onFrame(() => {
     return;
   }
   if (input.pressed("pause") && (runState === "running" || runState === "paused")) {
-    paused = !paused;
-    runState = paused ? "paused" : "running";
-    if (paused) void tunnelAudio.suspend();
-    else void tunnelAudio.resume();
+    if (pulseGame.session.paused) {
+      pulseGame.session.resume();
+      runState = "running";
+      void tunnelAudio.resume();
+    } else {
+      pulseGame.session.pause("user");
+      runState = "paused";
+      void tunnelAudio.suspend();
+    }
   }
-  if (runState !== "running" || paused) {
+  if (runState !== "running" || pulseGame.session.paused) {
     publish();
     return;
   }
@@ -1512,7 +1516,7 @@ function publish(styleSnapshot?: ReturnType<typeof styleSystem.step>): void {
   evidence.score = snapshot.score;
   evidence.state = runState;
   evidence.status = acceptedStatus();
-  evidence.paused = paused;
+  evidence.paused = pulseGame.session.paused;
   const schedulerNow = sample.time;
   // Keep the authored section and stem buses aligned even when a deterministic
   // evidence seek crosses several beat callbacks between rendered frames.
-- 
2.34.1

