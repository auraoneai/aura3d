-    obj = bpy.context.object
-    obj.name = name
-    return finish(obj, material, bevel)
-
-
-def torus(name, location, major, minor, material, rotation=(math.pi / 2, 0, 0)):
-    bpy.ops.mesh.primitive_torus_add(
