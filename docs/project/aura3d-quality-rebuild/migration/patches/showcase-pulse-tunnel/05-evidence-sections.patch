From b204eb3d9cd3e432ad056d78f5c88d02f9f7cea2 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:39:11 +0000
Subject: [PATCH] [QR-09] pulse-tunnel: evidence globals -> lazy sections

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-pulse-tunnel/src/evidence.ts | 17 +++++++++++++++++
 apps/showcase-pulse-tunnel/src/legacy/main.ts     | 17 +++++++----------
 2 files changed, 24 insertions(+), 10 deletions(-)
 create mode 100644 apps/showcase-pulse-tunnel/src/evidence.ts

diff --git a/apps/showcase-pulse-tunnel/src/evidence.ts b/apps/showcase-pulse-tunnel/src/evidence.ts
new file mode 100644
index 00000000..797725f5
--- /dev/null
+++ b/apps/showcase-pulse-tunnel/src/evidence.ts
@@ -0,0 +1,17 @@
+/**
+ * evidence.ts — lazy route evidence sections (PRD-09 §6.5). Loaded through the
+ * evidence channel's `sections()` loader only when evidence is requested;
+ * production play never imports this.
+ */
+export type EvidenceCollect = () => Record<string, unknown>;
+
+let collect: EvidenceCollect | undefined;
+
+export function bindPulseEvidence(fn: EvidenceCollect): void {
+  collect = fn;
+}
+
+export const sections = {
+  pulse: (): Record<string, unknown> =>
+    (collect ?? (() => ({ status: "unbound" })))()
+};
diff --git a/apps/showcase-pulse-tunnel/src/legacy/main.ts b/apps/showcase-pulse-tunnel/src/legacy/main.ts
index ed4a1a41..398d8a61 100644
--- a/apps/showcase-pulse-tunnel/src/legacy/main.ts
+++ b/apps/showcase-pulse-tunnel/src/legacy/main.ts
@@ -22,6 +22,7 @@ import {
   type RuntimeNodeHandleLike
 } from "@aura3d/engine";
 import { createGame } from "@aura3d/game";
+import { bindPulseEvidence } from "./evidence";
 import { assets } from "../../../src/aura-assets";
 import {
   PULSE_DRIFT_CHECKS_TO_FLIP,
@@ -103,6 +104,7 @@ const input = game.input({
 });
 
 const tunnelAudio = createTunnelAudio();
+bindPulseEvidence(() => evidence);
 const player = createPulsePlayer();
 const styleSystem = createPulseStyleSystem();
 const chart = buildPulseChart();
@@ -691,6 +693,11 @@ const pulseGame = createGame({
     seed: 20260912,
     continuousCollision: { mode: "adaptive-substeps", maxSubSteps: 4 }
   },
+  evidence: {
+    schema: 1,
+    sections: async () => (await import("./evidence")).sections,
+    legacyGlobals: ["__PULSE_TUNNEL_EVIDENCE__", "__AURA3D_SHOWCASE_PULSE_TUNNEL__"]
+  },
   qualityRebuild: { flags: ["game"] }
 });
 const pulseScene = scene()
@@ -993,16 +1000,6 @@ const evidence = {
   diagnostics: undefined as unknown
 };
 
-Object.defineProperty(window, "__PULSE_TUNNEL_EVIDENCE__", {
-  value: evidence,
-  configurable: true,
-  writable: true
-});
-// Registry convention alias (route-gates globalName); same object, not a second source.
-Object.defineProperty(window, "__AURA3D_SHOWCASE_PULSE_TUNNEL__", {
-  get: () => evidence,
-  configurable: true
-});
 
 /**
  * Test-only fault injection for the sync spec: shifts the drift monitor's readings
-- 
