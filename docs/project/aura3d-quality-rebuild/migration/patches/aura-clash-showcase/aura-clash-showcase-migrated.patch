+    description: "Opening match frame: fresh round, both fighters grounded at start distance (replaces ?capture=match-start).",
+    setup(): void {
+      const drive = clashDrive();
+      drive.reset();
+      drive.setPositions(-1.35, 1.35);
+      drive.pumpFrames(30);
