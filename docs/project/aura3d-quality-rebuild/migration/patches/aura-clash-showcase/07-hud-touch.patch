+    setTouch(action, held) {
+      const key = action as keyof typeof actionKeys;
+      if (!(key in actionKeys)) return;
+      if (held) {
+        if (!heldButtons.has(key)) pressedButtons.add(key);
+        heldButtons.add(key);
+      } else {
