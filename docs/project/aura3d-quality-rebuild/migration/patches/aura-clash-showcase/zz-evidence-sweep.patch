-        roundLocked: snap.combat?.roundLocked ?? false,
-        activeAttacks: (snap.combat?.activeAttacks ?? []).map((a) => a.moveId),
-        states: snap.states,
-        health: { p1: p1?.health ?? null, p2: p2?.health ?? null },
-        meter: { p1: p1?.meter ?? null, p2: p2?.meter ?? null },
