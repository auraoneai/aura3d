-  const out = new Float32Array(length);
-  for (let i = 0; i < length; i += 1) {
-    const t = i / SAMPLE_RATE - delay; // elapsed seconds since part onset
-    if (t < 0) continue;
-    const start = Math.min(1, t / attack);
-    const end = Math.pow(Math.max(0, 1 - t / total), decay);
-    out[i] = start * end;
-  }
-  return out;
-}
