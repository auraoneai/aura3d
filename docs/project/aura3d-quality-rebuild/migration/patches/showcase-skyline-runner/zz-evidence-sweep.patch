-function renderCue({ tone, noise }) {
-  const partTotals = Array.isArray(tone) ? tone.map((part) => part.total) : [tone?.total ?? 0];
-  const totalSec = Math.max(...partTotals, noise?.total ?? 0, 0.1) + 0.05;
