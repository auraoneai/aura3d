From b23c856292952394417f66d40ec58f33fe347438 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 18:08:12 +0000
Subject: [PATCH] [QR-09] skyline-runner: juice events + @aura3d/game dep

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-skyline-runner/package.json |  3 +-
 apps/showcase-skyline-runner/src/legacy/main.ts  | 34 ++++++++++++++++++++++-
 2 files changed, 35 insertions(+), 2 deletions(-)

diff --git a/apps/showcase-skyline-runner/package.json b/apps/showcase-skyline-runner/package.json
index bcf18a10..60e054b5 100644
--- a/apps/showcase-skyline-runner/package.json
+++ b/apps/showcase-skyline-runner/package.json
@@ -11,7 +11,8 @@
     "preview": "vite preview --host 127.0.0.1"
   },
   "dependencies": {
-    "@aura3d/engine": "workspace:*"
+    "@aura3d/engine": "workspace:*",
+    "@aura3d/game": "workspace:*"
   },
   "devDependencies": {
     "typescript": "^5.8.3",
diff --git a/apps/showcase-skyline-runner/src/legacy/main.ts b/apps/showcase-skyline-runner/src/legacy/main.ts
index 6ce0ceea..745d20d3 100644
--- a/apps/showcase-skyline-runner/src/legacy/main.ts
+++ b/apps/showcase-skyline-runner/src/legacy/main.ts
@@ -18,7 +18,14 @@ import {
   type AuraSceneNode,
   type RuntimeNodeHandleLike
 } from "@aura3d/engine";
-import { createGame } from "@aura3d/game";
+import {
+  createFxParticlePass,
+  createGame,
+  createJuice,
+  createOverlayDriver,
+  createRumbleDriver,
+  createTweenEngine
+} from "@aura3d/game";
 import { bindSkylineEvidence } from "./evidence";
 import { bindSkylineDrive } from "./scenario-drive";
 import { assets } from "../../../src/aura-assets";
@@ -2085,6 +2092,24 @@ bindSkylineDrive({
     app.resume();
   }
 });
+const skylineTween = createTweenEngine();
+const skylineFx = createFxParticlePass(app.effects);
+const skylineJuice = createJuice<"jump" | "collect" | "checkpoint" | "hazard" | "defeat" | "finish">({
+  events: {
+    jump: { fx: { kind: "streak", count: 5, color: "#9fd8ff" } },
+    collect: { fx: { kind: "pickup", count: 8, color: "#f7c948" }, punch: { fovDeg: 1.4, ms: 140 } },
+    checkpoint: { fx: { kind: "ring", count: 10, color: "#7ef4ff" }, flash: { color: "#7ef4ff", peak: 0.1, ms: 180 } },
+    hazard: { flash: { color: "#ff4d4d", peak: 0.22, ms: 260 }, vignette: { amount: 0.34, ms: 480, color: "#180407" }, hitStop: 0.055, shake: 0.2 },
+    defeat: { fx: { kind: "burst", count: 14, color: "#ffd166" }, shake: 0.16, punch: { fovDeg: 2.0, ms: 180 } },
+    finish: { fx: { kind: "ring", count: 20, color: "#ffe866" }, flash: { color: "#ffe866", peak: 0.18, ms: 300 } }
+  },
+  camera: app.camera,
+  session: skylineGame.session,
+  fx: skylineFx,
+  overlay: createOverlayDriver({ app }),
+  tweens: skylineTween,
+  rumble: createRumbleDriver()
+});
 bindSkylineEvidence(() => mountedEvidence);
 
 const player = app.nodes.require("platformer-player");
@@ -3655,6 +3680,7 @@ app.onFrame(({ dt }) => {
     if (event.type === "jump") {
       skylineFeel.onJump(eventScenePoint);
       triggerEventFeedbackVisual("jump", eventScenePoint);
+      skylineJuice.fire("jump", { position: [...eventScenePoint] });
     }
     if (event.type === "land") {
       skylineFeel.onLand(eventScenePoint);
@@ -3674,6 +3700,7 @@ app.onFrame(({ dt }) => {
         } else {
           skylineFeel.onCollect([sx, sy, GAMEPLAY_ACTOR_DEPTH]);
           triggerEventFeedbackVisual("collect", [sx, sy, GAMEPLAY_ACTOR_DEPTH]);
+          skylineJuice.fire("collect", { position: [sx, sy, GAMEPLAY_ACTOR_DEPTH] });
         }
       }
     }
@@ -3682,6 +3709,7 @@ app.onFrame(({ dt }) => {
       const district = resolveSkylineDistrict(state.player.x);
       skylineFeel.onCheckpoint(`${district.title} · ${act.title}`, eventScenePoint);
       triggerEventFeedbackVisual("relay", eventScenePoint);
+      skylineJuice.fire("checkpoint", { position: [...eventScenePoint] });
     }
     if (event.type === "hazard" || event.type === "fall") {
       // The kit emits hazard/fall and respawn in the same step. Anchor the damage
@@ -3690,6 +3718,7 @@ app.onFrame(({ dt }) => {
       const hazardVisiblePoint = platformerScene.toScenePlayer(state.player).position;
       skylineFeel.onHazard(hazardVisiblePoint);
       triggerEventFeedbackVisual("hazard", hazardVisiblePoint);
+      skylineJuice.fire("hazard", { position: [...hazardVisiblePoint] });
     }
     if (event.type === "respawn") {
       skylineFeel.onRespawn(eventScenePoint);
@@ -3701,14 +3730,17 @@ app.onFrame(({ dt }) => {
         const [sx, sy] = platformerScene.toScenePoint({ x: encounter.x, y: encounter.y });
         skylineFeel.onSentryDefeat([sx, sy, GAMEPLAY_ACTOR_DEPTH], event.type === "stomp" ? 100 : 150);
         triggerEventFeedbackVisual("defeat", [sx, sy, GAMEPLAY_ACTOR_DEPTH]);
+        skylineJuice.fire("defeat", { position: [sx, sy, GAMEPLAY_ACTOR_DEPTH] });
       }
     }
     if (event.type === "complete") {
       skylineFeel.onSummit(eventScenePoint);
       triggerEventFeedbackVisual("finish", eventScenePoint);
+      skylineJuice.fire("finish", { position: [...eventScenePoint] });
     }
   }
   updateEventFeedbackVisuals(step);
+  skylineTween.tick(step);
   challengeEvidence = runnerChallenge.step(step, previous, state);
   // SR-A1: capture the live input at fixed ticks while the run is live, and
   // finalize exactly once when the physical finish fires. A faster finish replaces
-- 
2.34.1

