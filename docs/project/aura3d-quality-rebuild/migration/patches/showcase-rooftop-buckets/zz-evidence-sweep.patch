-function quaternionFromEuler(x = 0, y = 0, z = 0) {
-  const cx = Math.cos(x / 2), sx = Math.sin(x / 2);
-  const cy = Math.cos(y / 2), sy = Math.sin(y / 2);
-  const cz = Math.cos(z / 2), sz = Math.sin(z / 2);
