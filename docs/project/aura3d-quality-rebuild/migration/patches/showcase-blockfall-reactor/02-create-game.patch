diff --git a/apps/showcase-blockfall-reactor/src/legacy/main.ts b/apps/showcase-blockfall-reactor/src/legacy/main.ts
index 9acd721a..767b10bd 100644
--- a/apps/showcase-blockfall-reactor/src/legacy/main.ts
+++ b/apps/showcase-blockfall-reactor/src/legacy/main.ts
@@ -1,6 +1,6 @@
 import {
   camera,
-  createGameApp,
+  createGame,
   effects,
   game,
   geometry,
@@ -84,7 +84,6 @@ import { createClearFx, createClearFxNodes, clearFxShardNodeId } from "./clear-f
 import { createCameraFeel } from "./camera-feel";
 import { createAttractPlayback, parseAttractRun } from "./attract";
