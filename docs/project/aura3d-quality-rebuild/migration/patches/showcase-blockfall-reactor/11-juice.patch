From 150b0584f0c7cff1bcc86e700917ecae7518b5c6 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:29:04 +0000
Subject: [PATCH] [QR-09] blockfall: juice facade
 (lock/clear/quad/level-up/game-over/denied)

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-blockfall-reactor/package.json |  3 +-
 apps/showcase-blockfall-reactor/src/legacy/main.ts  | 40 +++++++++++++++++++-
 2 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/apps/showcase-blockfall-reactor/package.json b/apps/showcase-blockfall-reactor/package.json
index 0d6e1fc2..117d321a 100644
--- a/apps/showcase-blockfall-reactor/package.json
+++ b/apps/showcase-blockfall-reactor/package.json
@@ -13,7 +13,8 @@
     "preview": "vite preview --host 127.0.0.1"
   },
   "dependencies": {
-    "@aura3d/engine": "workspace:*"
+    "@aura3d/engine": "workspace:*",
+    "@aura3d/game": "workspace:*"
   },
   "devDependencies": {
     "typescript": "^5.8.3",
diff --git a/apps/showcase-blockfall-reactor/src/legacy/main.ts b/apps/showcase-blockfall-reactor/src/legacy/main.ts
index 7eae08f2..7d044b9f 100644
--- a/apps/showcase-blockfall-reactor/src/legacy/main.ts
+++ b/apps/showcase-blockfall-reactor/src/legacy/main.ts
@@ -14,7 +14,14 @@ import {
   type GameFallingBlocksEvent,
   type GameFallingBlocksSnapshot
 } from "@aura3d/engine";
-import { createGame } from "@aura3d/game";
+import {
+  createFxParticlePass,
+  createGame,
+  createJuice,
+  createOverlayDriver,
+  createRumbleDriver,
+  createTweenEngine
+} from "@aura3d/game";
 import { blockfallScenarios } from "./scenarios";
 import { bindBlockfallDrive, type BlockfallAcceptanceScenario } from "./scenario-drive";
 import { bindBlockfallEvidence } from "./evidence";
@@ -664,6 +671,27 @@ const blockfallGame = createGame({
 const gameApp = blockfallGame.runtime;
 
 const app = gameApp.app;
+
+// ---- juice (PRD-09 §7.6) ----------------------------------------------------
+const blockfallTween = createTweenEngine();
+const blockfallFx = createFxParticlePass(app.effects);
+const blockfallJuice = createJuice<"lock" | "line-clear" | "quad" | "level-up" | "game-over" | "rotate-denied">({
+  events: {
+    lock: { fx: { kind: "dust", count: 5, color: "#8ff7ff" }, shake: 0.06 },
+    "line-clear": { fx: { kind: "streak", count: 12, color: "#48d9e5" }, flash: { color: "#48d9e5", peak: 0.14, ms: 140 } },
+    quad: { fx: { kind: "ring", count: 20, color: "#ffe866" }, shake: 0.22, punch: { fovDeg: 3.5, ms: 160 }, hitStop: 0.05 },
+    "level-up": { fx: { kind: "spark", count: 10, color: "#e279ff" }, flash: { color: "#e279ff", peak: 0.12, ms: 160 } },
+    "game-over": { flash: { color: "#ff4d4d", peak: 0.22, ms: 300 }, vignette: { amount: 0.4, ms: 500, color: "#20060a" }, hitStop: 0.06 },
+    "rotate-denied": { flash: { color: "#ff4d4d", peak: 0.1, ms: 120 } }
+  },
+  camera: app.camera,
+  session: blockfallGame.session,
+  fx: blockfallFx,
+  overlay: createOverlayDriver({ app }),
+  tweens: blockfallTween,
+  rumble: createRumbleDriver()
+});
+
 const input = gameApp.input!;
 if (!input) throw new Error("Blockfall Reactor failed to create Aura3D input.");
 
@@ -1002,6 +1030,7 @@ let lastPublishedLevel = 1;
 
 gameApp.onFrame(({ dt }) => {
   input.update(dt);
+  blockfallTween.tick(dt);
 
   // Exact acceptance captures intentionally freeze gameplay after a real kit
   // transition. `app.step(0)` is still allowed to flush the renderer, but it
@@ -1166,7 +1195,10 @@ function advanceFallingBlocks(actions: readonly BlockfallAction[] = []): Blockfa
     // "accepted". Edge-triggered per refused press via the event absence.
     if (action.type === "rotate" && !accepted.has("rotate")) {
       observedGameplayProof.rotateDenied += 1;
-      if (!reducedMotion) rotateDeniedFlash = ROTATE_DENIED_FLASH_SECONDS;
+      if (!reducedMotion) {
+        rotateDeniedFlash = ROTATE_DENIED_FLASH_SECONDS;
+        blockfallJuice.fire("rotate-denied");
+      }
     }
     lastMove = formatBlockfallAction(action);
     countFallingBlockEvents(lastFallingEvents, rowsBeforeAction);
@@ -1203,6 +1235,7 @@ function countFallingBlockEvents(
     placedPieces += locks;
     observedGameplayProof.eventCounts.lock += locks;
     void reactorAudio.cue("lock");
+    blockfallJuice.fire("lock", { position: [0, burstRowY, 0.4] });
   }
   if (lineClears > 0) {
     observedGameplayProof.lineClear = true;
@@ -1221,6 +1254,7 @@ function countFallingBlockEvents(
     }
     void reactorAudio.cue(quad ? "quad" : "line-clear");
     clearFx.burst(clearedVisibleRows, linesCleared);
+    blockfallJuice.fire(quad ? "quad" : "line-clear", { position: [0, burstRowY, 0.4] });
     if (quad) cameraFeel.punch(1.6, "quad");
   }
   if (gameOvers > 0) {
@@ -1229,6 +1263,7 @@ function countFallingBlockEvents(
     beatTimers.gameOver = beatDurations.gameOver;
     observedBeatProof.gameOver = true;
     void reactorAudio.cue("game-over");
+    blockfallJuice.fire("game-over");
   }
   const snapshot = fallingBlocks.snapshot();
   observedGameplayProof.scoring ||= snapshot.score > 0;
@@ -1238,6 +1273,7 @@ function countFallingBlockEvents(
     beatTimers.levelUp = beatDurations.levelUp;
     observedBeatProof.levelUp = true;
     void reactorAudio.cue("level-up");
+    blockfallJuice.fire("level-up");
     cameraFeel.punch(1.1, "level-up");
   }
 }
-- 
2.34.1

