-              sample += Math.sin(2 * Math.PI * f * localT) * toneAmp * env;
-            }
-          }
-        }
-      }
-
-      out[i] += sample;
-    }
-  }
-
-  // Crossfade edges so it's guaranteed 100% click-free
-  const fade = Math.floor(0.015 * SAMPLE_RATE);
-  for (let i = 0; i < fade; i += 1) {
-    const k = i / fade;
