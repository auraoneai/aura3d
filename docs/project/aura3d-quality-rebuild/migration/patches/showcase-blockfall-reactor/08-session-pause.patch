From 80e12fb15e73216694a09a353eed1fe3a7313cbd Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:27:15 +0000
Subject: [PATCH] [QR-09] blockfall: paused flag -> game.session

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-blockfall-reactor/src/main.ts | 32 +++++++++++++--------
 1 file changed, 20 insertions(+), 12 deletions(-)

diff --git a/apps/showcase-blockfall-reactor/src/main.ts b/apps/showcase-blockfall-reactor/src/main.ts
index 57363133..00aba46f 100644
--- a/apps/showcase-blockfall-reactor/src/main.ts
+++ b/apps/showcase-blockfall-reactor/src/main.ts
@@ -794,7 +794,6 @@ const fallingBlocks = game.fallingBlocks({
   board: createOpeningBoard()
 });
 fallingBlocks.setActive({ kind: "T", x: Math.floor(BOARD_WIDTH / 2) - 2, y: PRESENTATION_ACTIVE_Y, rotation: 0 });
-let paused = false;
 let placedPieces = 0;
 let lockCount = 0;
 let lastFallingEvents: readonly GameFallingBlocksEvent[] = fallingBlocks.snapshot().events;
@@ -971,7 +970,7 @@ bindBlockfallDrive({
   stageRotationTrap: () => {
     const snapshot = fallingBlocks.snapshot();
     const active = snapshot.active;
-    if (!active || snapshot.gameOver || paused) return false;
+    if (!active || snapshot.gameOver || blockfallGame.session.paused) return false;
     const occupied = new Set(
       pieceCells({ kind: active.kind, x: active.x, y: active.y, rotation: active.rotation }).map(
         (cell) => `${cell.x},${cell.y}`
@@ -1023,7 +1022,8 @@ gameApp.onFrame(({ dt }) => {
       manualInputState.pressed.clear();
       queuedActions = [];
       replayPlayback = { active: false, frame: 0 };
-      paused = false;
+      blockfallGame.session.resume();
+      app.resume();
       placedPieces = 0;
       lockCount = 0;
       const freshSnapshot = fallingBlocks.reset(DEFAULT_SEED);
@@ -1043,7 +1043,7 @@ gameApp.onFrame(({ dt }) => {
     || manualInputState.pressed.size > 0
     || manualInputState.held.size > 0
     || BLOCKFALL_INPUT_NAMES.some((name) => input.pressed(name) || input.held(name));
-  if (!attractState.active && !paused && !state.gameOver && !replayPlayback.active) {
+  if (!attractState.active && !blockfallGame.session.paused && !state.gameOver && !replayPlayback.active) {
     if (anyInputThisFrame || dt === 0) {
       attractState.idleSeconds = 0;
     } else {
@@ -1118,12 +1118,19 @@ function advanceFallingBlocks(actions: readonly BlockfallAction[] = []): Blockfa
 
   for (const action of actions) {
     if (action.type === "pause") {
-      paused = !paused;
-      lastMove = paused ? "pause" : "resume";
+      if (blockfallGame.session.paused) {
+        blockfallGame.session.resume();
+        app.resume();
+      } else {
+        blockfallGame.session.pause("user");
+        app.pause();
+      }
+      lastMove = blockfallGame.session.paused ? "pause" : "resume";
       continue;
     }
     if (action.type === "reset") {
-      paused = false;
+      blockfallGame.session.resume();
+      app.resume();
       placedPieces = 0;
       lockCount = 0;
       const resetSnapshot = fallingBlocks.reset(action.seed ?? DEFAULT_SEED);
@@ -1138,7 +1145,7 @@ function advanceFallingBlocks(actions: readonly BlockfallAction[] = []): Blockfa
       observedBeatProof.reset = true;
       continue;
     }
-    if (paused || state.gameOver) continue;
+    if (blockfallGame.session.paused || state.gameOver) continue;
     const fallingAction = toFallingBlockAction(action);
     if (action.type === "move") observedGameplayProof.movement = true;
     if (action.type === "rotate") observedGameplayProof.rotation = true;
@@ -1163,7 +1170,7 @@ function advanceFallingBlocks(actions: readonly BlockfallAction[] = []): Blockfa
     countFallingBlockEvents(lastFallingEvents, rowsBeforeAction);
   }
 
-  if (!resetApplied && !paused && !fallingBlocks.snapshot().gameOver) {
+  if (!resetApplied && !blockfallGame.session.paused && !fallingBlocks.snapshot().gameOver) {
     const rowsBeforeTick = captureFullVisibleRows();
     const tickSnapshot = fallingBlocks.tick();
     lastFallingEvents = tickSnapshot.events;
@@ -1311,7 +1318,7 @@ function applyAcceptanceScenario(scenario: BlockfallAcceptanceScenario): unknown
   app.pause();
   exitAttract("acceptance-probe");
   acceptanceScenario = scenario;
-  paused = false;
+  blockfallGame.session.resume();
   replayPlayback = { active: false, frame: 0 };
   placedPieces = 0;
   lockCount = 0;
@@ -1394,7 +1401,7 @@ function createBlockfallView(snapshot: GameFallingBlocksSnapshot, lastMove: stri
     piecesPlaced: placedPieces,
     lockCount,
     frame: snapshot.frame,
-    paused,
+    paused: blockfallGame.session.paused,
     gameOver: snapshot.gameOver,
     lastMove,
     lastClearedLines: lineClear?.lines ?? 0,
@@ -2240,7 +2247,8 @@ function installDomControls(): void {
 
 function startReplayPlayback(): void {
   exitAttract("replay-button");
-  paused = false;
+  blockfallGame.session.resume();
+  app.resume();
   placedPieces = 0;
   lockCount = 0;
   const resetSnapshot = fallingBlocks.reset(DEFAULT_SEED);
-- 
2.34.1

