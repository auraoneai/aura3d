-    const t = i / SAMPLE_RATE;
-    const start = Math.min(1, t / Math.max(0.0005, attack));
-    const end = Math.pow(Math.max(0, 1 - t / total), decay);
-    out[i] = start * end;
-  }
-  return out;
-}
