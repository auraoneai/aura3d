-            mx, mz = (ax + bx) / 2, (az + bz) / 2
-            for height in (0.32, 0.58):
-                box(f"Armco rail {start}-{index}-{height}", at(mx, mz, height), (length + 0.08, 0.11, 0.12), STEEL, rotation_z=-yaw, edge=0.035)
-            if index % 2 == 0:
