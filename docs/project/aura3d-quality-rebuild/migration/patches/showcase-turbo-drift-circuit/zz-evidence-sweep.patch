-    [155.56, 233.08, 293.66, 349.23], // Ebmaj7 (Eb3, Bb3, D4, F4)
-    [146.83, 220.00, 293.66, 349.23], // Bb/D (D3, A3, D4, F4)
-    [130.81, 196.00, 261.63, 311.13], // Cm7 (C3, G3, C4, Eb4)
