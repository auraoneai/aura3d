-  for (let i = 0; i < length; i++) {
-    const t = i / SAMPLE_RATE;
-    const chordIndex = Math.floor((t / durationSec) * chords.length) % chords.length;
-    const chordProgress = (t % (durationSec / chords.length)) / (durationSec / chords.length);
