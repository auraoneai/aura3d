-  const out = new Float32Array(N);
-  for (let i = 0; i < N; i++) {
-    const t = i / SAMPLE_RATE;
-    const breath = 0.7 + 0.3 * Math.sin(2 * Math.PI * 0.15 * t);
-    const distantHum = Math.sin(2 * Math.PI * 55 * t) * 0.06;
