From 0df52c47b0ab75b863d49ca7c084d2e74b8d2ff9 Mon Sep 17 00:00:00 2001
From: Gurbaksh Chahal <gchahal@veerone.com>
Date: Tue, 6 Oct 2026 17:59:41 +0000
Subject: [PATCH] [QR-09] gravity-post: paused flag -> game.session

Co-Authored-By: Devin AI <158243242+devin-ai-integration[bot]@users.noreply.github.com>
---
 apps/showcase-gravity-post/src/legacy/main.ts | 25 ++++++++++++++-----------
 1 file changed, 14 insertions(+), 11 deletions(-)

diff --git a/apps/showcase-gravity-post/src/legacy/main.ts b/apps/showcase-gravity-post/src/legacy/main.ts
index 639ff3fd..620c1040 100644
--- a/apps/showcase-gravity-post/src/legacy/main.ts
+++ b/apps/showcase-gravity-post/src/legacy/main.ts
@@ -1206,7 +1206,6 @@ let failedContracts = 0;
 let completedContracts = 0;
 let shiftOver = false;
 let campaignComplete = false;
-let paused = false;
 let aiming = false;
 let warpActive = false;
 let frame = 0;
@@ -1318,7 +1317,7 @@ if (canvas) {
   canvas.style.touchAction = "none";
   canvas.addEventListener("pointerdown", (event) => {
     audio.unlock();
-    if (pod.state !== "ready" || paused || flyby.active) return;
+    if (pod.state !== "ready" || gravityGame.session.paused || flyby.active) return;
     aiming = true;
     aimStart.x = event.clientX;
     aimStart.y = event.clientY;
@@ -1460,7 +1459,7 @@ function retryContract(): void {
     skipFlyby(flyby);
     updateFlyby(flyby, 0);
   }
-  paused = false;
+  gravityGame.session.resume();
   aiming = false;
   audio.play("ui-confirm");
   lastScoreCard = null;
@@ -1978,7 +1977,7 @@ function renderHud(): void {
     '<button id="gp-warp" type="button">Warp hold</button>',
     '<button id="gp-retry" type="button">Retry (R)</button>',
     '<button id="gp-next" type="button"' + (pod.state === "docked" ? "" : " disabled") + '>Next (N)</button>',
-    '<button id="gp-pause" type="button" aria-pressed="' + paused + '">' + (paused ? "Resume" : "Pause") + "</button>",
+    '<button id="gp-pause" type="button" aria-pressed="' + gravityGame.session.paused + '">' + (gravityGame.session.paused ? "Resume" : "Pause") + "</button>",
     "</div>",
     "</section>",
     scoreCardHtml,
@@ -1987,7 +1986,10 @@ function renderHud(): void {
 
   hud.querySelector("#gp-retry")?.addEventListener("click", () => { audio.unlock(); retryContract(); });
   hud.querySelector("#gp-next")?.addEventListener("click", () => { audio.unlock(); nextContract(); });
-  hud.querySelector("#gp-pause")?.addEventListener("click", () => { paused = !paused; });
+  hud.querySelector("#gp-pause")?.addEventListener("click", () => {
+    if (gravityGame.session.paused) gravityGame.session.resume();
+    else gravityGame.session.pause("user");
+  });
   hud.querySelector("#gp-correct-pro")?.addEventListener("click", () => { audio.unlock(); emitPodEvents(applyCorrection(pod, 1)); });
   hud.querySelector("#gp-correct-retro")?.addEventListener("click", () => { audio.unlock(); emitPodEvents(applyCorrection(pod, -1)); });
   bindHold("#gp-warp", () => { touchWarp = true; }, () => { touchWarp = false; });
@@ -2048,7 +2050,7 @@ function publishEvidence(): void {
     score,
     shiftOver,
     campaignComplete,
-    paused,
+    paused: gravityGame.session.paused,
     warping: warpActive,
     aiming,
     adriftSeconds: Math.round(pod.adriftSeconds * 10) / 10,
@@ -2099,11 +2101,12 @@ function updateGameplay(dt: number): void {
 
   input.update(dt);
   if (input.pressed("pause")) {
-    paused = !paused;
+    if (gravityGame.session.paused) gravityGame.session.resume();
+    else gravityGame.session.pause("user");
   }
   if (input.pressed("retry")) retryContract();
   if (input.pressed("next")) nextContract();
-  if (paused) {
+  if (gravityGame.session.paused) {
     warpActive = false;
     publishEvidence();
     return;
@@ -2197,7 +2200,7 @@ window.__GRAVITY_POST_CAPTURE__ = () => {
 if (new URLSearchParams(location.search).has("planetProbe")) {
   (window as unknown as Record<string, unknown>).__GRAVITY_POST_PLANET_PROBE__ = {
     async capture(visible: boolean) {
-      paused = true;
+      gravityGame.session.pause("user");
       app.pause();
       await app.ready();
       const planets = WELL_BODIES.filter(body => body.id !== "sol").map(body => {
@@ -2237,7 +2240,7 @@ Object.defineProperty(window, "__AURA3D_COMPOSITION_PROBE__", {
       // Visibility mutates retained nodes; it does not present pixels. Freeze
       // the RAF owner and explicitly await the frame containing this mutation
       // so a busy browser cannot capture the previous visible frame twice.
-      paused = true;
+      gravityGame.session.pause("user");
       app.pause();
       await app.ready();
       compositionSubjectSuppressed = suppressed;
@@ -2260,7 +2263,7 @@ Object.defineProperty(window, "__AURA3D_COMPOSITION_PROBE__", {
       await app.stepAsync(0);
     },
     async settleSubjectPose() {
-      paused = true;
+      gravityGame.session.pause("user");
       app.pause();
       await app.ready();
             resetPodForContract(pod, contract());
-- 
2.34.1

