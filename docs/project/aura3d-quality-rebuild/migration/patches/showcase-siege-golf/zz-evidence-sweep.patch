-  const breath = new Float32Array(length);
-  let lpPrev = 0;
-  const rc = 1 / (2 * Math.PI * 500);
-  const dt = 1 / SAMPLE_RATE;
-  const alpha = dt / (rc + dt);
-  for (let i = 0; i < length; i += 1) {
-    seed = (seed * 1664525 + 1013904223) >>> 0;
