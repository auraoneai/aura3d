     player.invulnerableRemaining = 0;
     player.contactDebt = 0;
     swarm.spawn({ x: player.x, z: player.z, archetype: "grunt", speedMultiplier: 0 });
-    publishEvidence();
+    collectRouteEvidence();
   },
   dumpDiagnostics() {
     try {
@@ -1949,4 +1981,4 @@ app.onFrame(({ time }) => {
 });
 
 resetRun(SEED_DEFAULT);
-publishEvidence();
