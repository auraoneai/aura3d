   },
   stageBurstCluster(count = 10) {
     if (runState !== "wave-active") return;
@@ -1906,7 +1938,7 @@ window.__NEON_SWARM_DEBUG__ = {
         speedMultiplier: i === count - 1 ? 0 : 1
       });
