+  },
   qualityRebuild: { flags: ["game"] }
 });
 const app = neonGame.app;
 neonGame.start();
 
+bindNeonEvidence(() => collectRouteEvidence());
+bindNeonDrive({
+  jumpToWave(target: number): void {
+    if (target >= 1) startWave(Math.floor(target));
+  },
+  stageFinalePulse(): void {
+    if (runState !== "wave-active" || wave !== MAX_CAMPAIGN_WAVES) return;
+    burstCharge = 100;
+    mouseAim = { x: 0.66, z: -0.75 };
+    player.fireCooldownRemaining = 0;
+    firePulse();
+    update(1 / 60);
+  },
+  finishFinale(): void {
+    if (runState !== "wave-active" || wave !== MAX_CAMPAIGN_WAVES) return;
+    spawnedCount = schedule.length;
+    waveElapsed = Math.max(waveElapsed, FINALE_SURVIVAL_SECONDS);
+    update(1 / 60);
+  },
+  stepFixed(frames: number): void {
+    for (let i = 0; i < frames; i += 1) update(1 / 60);
+  }
+});
+
 const input = game.input({
   actions: {
     up: ["KeyW", "ArrowUp"],
@@ -1103,7 +1136,7 @@ function chooseDoor(kind: string): void {
   // gameplay truth until the next frame, and not at all while rAF is suspended in a
   // backgrounded tab. Re-publish here so the projection can never contradict gameplay
   // state, exactly as the staged evidence paths below already do.
-  publishEvidence();
+  collectRouteEvidence();
 }
 
 function collectRiskPickup(): void {
@@ -1358,7 +1391,7 @@ function update(dt: number): void {
   }
 
   if (neonGame.session.paused) {
-    publishEvidence();
