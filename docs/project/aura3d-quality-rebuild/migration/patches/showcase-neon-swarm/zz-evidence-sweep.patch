-}
-/** Dash — air whoosh: band-passed noise swell with a rising tail. */
-function dash() {
-  return renderCue({
-    tone: { wave: "sine", freqStart: 240, freqEnd: 620, amp: 0.16, attack: 0.05, decay: 3, total: 0.28 },
-    noise: { amp: 0.34, attack: 0.04, decay: 3.4, total: 0.3, hp: 320 }
