-}
-/** Wave clear — resolving neon triad. */
-function waveClear() {
-  return renderCue({ tone: [
-    { wave: "triangle", freqStart: 523, amp: 0.3, attack: 0.01, decay: 3.4, total: 0.5 },
-    { wave: "triangle", freqStart: 659, amp: 0.26, attack: 0.09, decay: 3.4, total: 0.52 },
