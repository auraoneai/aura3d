-function radialBurst() {
-  return renderCue({ tone: [
-    { wave: "sine", freqStart: 90, freqEnd: 180, amp: 0.46, attack: 0.008, decay: 2.8, total: 0.56 },
-    { wave: "triangle", freqStart: 360, freqEnd: 980, amp: 0.32, attack: 0.05, decay: 3.2, total: 0.5 },
