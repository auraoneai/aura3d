-function deathSting() {
-  return renderCue({
-    tone: [
-      { wave: "sawtooth", freqStart: 392, freqEnd: 70, amp: 0.4, attack: 0.004, decay: 4.6, total: 0.85 },
-      { wave: "sine", freqStart: 196, freqEnd: 48, amp: 0.34, attack: 0.004, decay: 4, total: 0.9 }
-    ],
-    noise: { amp: 0.16, attack: 0.002, decay: 5, total: 0.4 }
