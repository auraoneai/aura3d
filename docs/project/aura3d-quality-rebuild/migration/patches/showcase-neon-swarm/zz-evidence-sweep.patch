-function comboBreak() {
-  return renderCue({ tone: [
-    { wave: "square", freqStart: 440, freqEnd: 220, amp: 0.25, attack: 0.002, decay: 6, total: 0.19 },
-    { wave: "sine", freqStart: 330, freqEnd: 110, amp: 0.3, attack: 0.06, decay: 5, total: 0.3 }
-  ] });
-}
