+      - "tests/visual/skinned-animation-pixels.spec.ts"
+      - "tests/quality-gate.global-setup.ts"
+      - "playwright.quality-gate.config.ts"
+      - ".github/workflows/quality-gate.yml"
+      - ".github/workflows/quality-rebuild-capture.yml"
   push:
     branches: ["main"]
   workflow_call:
+  workflow_dispatch:
 
