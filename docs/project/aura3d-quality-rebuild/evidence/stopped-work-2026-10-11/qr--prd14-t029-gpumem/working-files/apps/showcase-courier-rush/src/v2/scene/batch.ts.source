// apps/showcase-courier-rush/src/v2/scene/batch.ts — T0-29 draw-call diet.
// The day cityBlock kit plus the route's skyline/street dressing mount ~600
// one-off static boxes/cylinders/spheres. Each is its own draw (and its own
// shadow-pass draw), which is what pushed the opening frame to 2.4k-3k draws
// on the track0 L4 runner and made the capture outlive its 150 s watchdog.
//
// `batchStaticPrimitives` folds every plain static primitive — no runtime id,
// no animation/physics/interaction, Euler rotation only, opaque material — into
// one `instances.<primitive>` node per (primitive, material, shadow flags).
// Transforms are copied verbatim, so the pixels match the one-off nodes; any
// node carrying extra semantics is passed through untouched.
import { instances, type AuraNodeInput, type AuraPrimitiveNode, type AuraSceneNode, type AuraTransformSpec } from "@aura3d/engine";

type InstancedPrimitive = "box" | "sphere" | "plane" | "cylinder" | "capsule" | "torus";
const INSTANCED: ReadonlySet<string> = new Set<InstancedPrimitive>(["box", "sphere", "plane", "cylinder", "capsule", "torus"]);

/** Keys a primitive may set (with a defined value) and still be batched. */
const BATCHABLE_KEYS: ReadonlySet<string> = new Set([
  "kind", "primitive", "name", "position", "rotation", "scale", "material", "castShadow", "receiveShadow"
]);

function toSceneNode(input: AuraNodeInput): AuraSceneNode {
  const maybe = input as { toJSON?: () => AuraSceneNode };
  return typeof maybe.toJSON === "function" ? maybe.toJSON() : (input as AuraSceneNode);
}

function isOpaque(material: AuraPrimitiveNode["material"]): boolean {
  if (material === undefined) return true;
  const spec = material as { opacity?: number; transparent?: boolean; transmission?: number; alphaMode?: string };
  if (spec.transparent === true) return false;
  if (typeof spec.opacity === "number" && spec.opacity < 1) return false;
  if (typeof spec.transmission === "number" && spec.transmission > 0) return false;
  if (spec.alphaMode !== undefined && spec.alphaMode !== "OPAQUE") return false;
  return true;
}

function batchKey(node: AuraSceneNode): string | undefined {
  if (node.kind !== "primitive") return undefined;
  const prim = node as AuraPrimitiveNode;
  if (!INSTANCED.has(prim.primitive) || prim.instances !== undefined) return undefined;
  for (const [key, value] of Object.entries(prim)) {
    if (value !== undefined && !BATCHABLE_KEYS.has(key)) return undefined;
  }
  if (!isOpaque(prim.material)) return undefined;
  return [prim.primitive, JSON.stringify(prim.material ?? null), String(prim.castShadow), String(prim.receiveShadow)].join("|");
}

function transformOf(node: AuraPrimitiveNode): AuraTransformSpec {
  return {
    ...(node.position !== undefined ? { position: node.position } : {}),
    ...(node.rotation !== undefined ? { rotation: node.rotation } : {}),
    ...(node.scale !== undefined ? { scale: node.scale } : {})
  };
}

export interface StaticBatchResult {
  readonly nodes: AuraNodeInput[];
  /** One-off primitives folded into instanced batches. */
  readonly folded: number;
  /** Instanced batch nodes emitted for them. */
  readonly batches: number;
}

/**
 * Fold plain static primitives into instanced batches. Groups are recursed so
 * a scaled kit group keeps its own transform; a batch never crosses a group
 * boundary. Batches of one are left as the original node.
 */
export function batchStaticPrimitives(inputs: readonly AuraNodeInput[], label: string): StaticBatchResult {
  const out: AuraNodeInput[] = [];
  const buckets = new Map<string, AuraPrimitiveNode[]>();
  const order: Array<{ readonly key: string } | { readonly node: AuraNodeInput }> = [];
  let folded = 0;
  let batches = 0;

  for (const input of inputs) {
    const node = toSceneNode(input);
    if (node.kind === "group") {
      const inner = batchStaticPrimitives(node.children, label);
      folded += inner.folded;
      batches += inner.batches;
      order.push({ node: { ...node, children: inner.nodes.map(toSceneNode) } });
      continue;
    }
    const key = batchKey(node);
    if (key === undefined) {
      order.push({ node: input });
      continue;
    }
    let bucket = buckets.get(key);
    if (!bucket) {
      bucket = [];
      buckets.set(key, bucket);
      order.push({ key });
    }
    bucket.push(node as AuraPrimitiveNode);
  }

  let batchIndex = 0;
  for (const entry of order) {
    if ("node" in entry) {
      out.push(entry.node);
      continue;
    }
    const bucket = buckets.get(entry.key)!;
    const first = bucket[0]!;
    if (bucket.length === 1) {
      out.push(first);
      continue;
    }
    batchIndex += 1;
    folded += bucket.length;
    batches += 1;
    const build = instances[first.primitive as InstancedPrimitive];
    out.push(build({
      name: `${label} batch ${batchIndex}: ${first.name ?? first.primitive} x${bucket.length}`,
      ...(first.material !== undefined ? { material: first.material } : {}),
      ...(first.castShadow !== undefined ? { castShadow: first.castShadow } : {}),
      ...(first.receiveShadow !== undefined ? { receiveShadow: first.receiveShadow } : {}),
      transforms: bucket.map(transformOf)
    }));
  }
  return { nodes: out, folded, batches };
}
