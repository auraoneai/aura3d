import { test } from "vitest";
import { courierWorldNodes } from "../../../../apps/showcase-courier-rush/src/v2/scene/world";
const J = (n: any) => (typeof n?.toJSON === "function" ? n.toJSON() : n);
const K = (n: any) => n.type ?? n.kind;
test("count", () => {
  const nodes = courierWorldNodes().nodes.map(J);
  const g = nodes.find((n: any) => K(n) === "group");
  console.log("top", nodes.length, "groupChildren", g.children.length, JSON.stringify(Object.keys(g)));
  const byMat: Record<string, number> = {};
  for (const c0 of g.children) {
    const c = J(c0);
    const k = `${K(c)}:${c.primitive}:${c.material?.name ?? JSON.stringify(c.material)?.slice(0, 60)}:${c.castShadow}:${(c.children ?? []).length}:${c.instances ? "inst" : ""}`;
    byMat[k] = (byMat[k] ?? 0) + 1;
  }
  console.log(JSON.stringify(Object.entries(byMat).sort((a, b) => b[1] - a[1]).slice(0, 25)));
  const top: Record<string, number> = {};
  for (const c of nodes) {
    if (K(c) !== "primitive") continue;
    const k = `${c.primitive}:${c.material?.name ?? "?"}:${c.instances ? "inst" : ""}`;
    top[k] = (top[k] ?? 0) + 1;
  }
  console.log(JSON.stringify(Object.entries(top).sort((a, b) => b[1] - a[1]).slice(0, 25)));
  console.log(JSON.stringify(J(g.children[0])).slice(0, 600));
});
