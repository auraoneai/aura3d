{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura3d.prd13.s-record.craft-ratio/1",
  "title": "13-S5 craft-ratio record: tests/reports/craft-ratio.json produced in CI on main plus a signed art-director note",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "row", "runId", "runUrl", "workflow", "job", "branch", "provider", "headSha", "recordedAt", "command", "reportPath", "reportSchema", "reportSha256", "artDirectorNote"],
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "string" },
    "kind": { "const": "craft-ratio" },
    "row": { "const": "13-S5" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runUrl": { "type": "string", "pattern": "^https://github\\.com/auraoneai/aura3d/actions/runs/[1-9][0-9]*" },
    "workflow": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
    "job": { "type": "string", "minLength": 1 },
    "branch": { "const": "main" },
    "provider": { "const": "github-macos-14" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "command": { "const": "pnpm exec tsx --tsconfig tsconfig.base.json tools/agent-skills/craft-ratio.ts" },
    "reportPath": { "const": "tests/reports/craft-ratio.json" },
    "reportSchema": { "const": "aura3d.craft-ratio/1" },
    "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the CI artifact copy; must equal the committed file" },
    "artDirectorNote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "signedAt", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "signedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}" },
        "path": { "type": "string", "pattern": "\\.md$" }
      }
    }
  }
}
