{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura3d.prd13.s-record.three-compat-comparison/1",
  "title": "13-S8 three-compat comparison: 8 three-compat templates captured on macos-14 and judged against named three.js r185 examples; gap recorded, parity never claimed",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "row", "runId", "runUrl", "workflow", "job", "branch", "provider", "headSha", "recordedAt", "baselineRunId", "threeRevision", "judges", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "string" },
    "kind": { "const": "three-compat-comparison" },
    "row": { "const": "13-S8" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runUrl": { "type": "string", "pattern": "^https://github\\.com/auraoneai/aura3d/actions/runs/[1-9][0-9]*" },
    "workflow": { "const": ".github/workflows/template-lookdev.yml" },
    "job": { "const": "capture" },
    "branch": { "const": "main" },
    "provider": { "const": "github-macos-14" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "baselineRunId": { "type": "string", "pattern": "^[1-9][0-9]*$", "description": "13-BASE run whose v3.0.1 frames give baselineScore" },
    "threeRevision": { "const": "r185" },
    "judges": {
      "type": "array",
      "minItems": 2,
      "contains": { "type": "object", "required": ["type"], "properties": { "type": { "const": "human" } } },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name"],
        "properties": {
          "type": { "enum": ["vision", "human"] },
          "name": { "type": "string", "minLength": 1 },
          "model": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "threeExample", "threeExampleFrame", "aura3dFrame", "baselineScore", "score", "threeExampleScore", "gap", "parityClaimed"],
        "properties": {
          "template": { "type": "string", "pattern": "^three-compat-[a-z0-9-]+$" },
          "threeExample": { "type": "string", "minLength": 1, "description": "three.js r185 example name, e.g. webgl_loader_gltf" },
          "threeExampleFrame": { "type": "string", "pattern": "\\.png$" },
          "aura3dFrame": { "type": "string", "pattern": "\\.png$" },
          "baselineScore": { "type": "number", "minimum": 0, "maximum": 10 },
          "score": { "type": "number", "minimum": 0, "maximum": 10 },
          "threeExampleScore": { "type": "number", "minimum": 0, "maximum": 10 },
          "gap": { "type": "number", "description": "threeExampleScore - score" },
          "parityClaimed": { "const": false }
        }
      }
    }
  }
}
