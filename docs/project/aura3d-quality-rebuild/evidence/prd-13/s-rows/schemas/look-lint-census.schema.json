{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura3d.prd13.s-record.look-lint-census/1",
  "title": "13-S4 look-lint census: aura3d look lint over 18 games + 19 baselines + 4 broken controls, with a 5-subject human spot-check",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "row", "runId", "runUrl", "workflow", "job", "branch", "provider", "headSha", "recordedAt", "baselineRunId", "command", "entries", "summary", "humanSpotCheck"],
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "string" },
    "kind": { "const": "look-lint-census" },
    "row": { "const": "13-S4" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runUrl": { "type": "string", "pattern": "^https://github\\.com/auraoneai/aura3d/actions/runs/[1-9][0-9]*" },
    "workflow": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
    "job": { "type": "string", "minLength": 1 },
    "branch": { "const": "main" },
    "provider": { "const": "github-macos-14" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "baselineRunId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "command": { "type": "string", "pattern": "^aura3d look lint" },
    "entries": {
      "type": "array",
      "minItems": 41,
      "maxItems": 41,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "group", "errors", "warnings", "codes"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "group": { "enum": ["game", "baseline", "broken-control"] },
          "errors": { "type": "integer", "minimum": 0 },
          "warnings": { "type": "integer", "minimum": 0 },
          "codes": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["games", "baselines", "brokenControls", "cleanRatio", "errorCount", "brokenControlsFlagged"],
      "properties": {
        "games": { "const": 18 },
        "baselines": { "const": 19 },
        "brokenControls": { "const": 4 },
        "cleanRatio": { "type": "number", "minimum": 0, "maximum": 1, "description": "clean games+baselines / 37" },
        "errorCount": { "type": "integer", "minimum": 0, "description": "error-severity findings over games+baselines" },
        "brokenControlsFlagged": { "type": "integer", "minimum": 0, "maximum": 4 }
      }
    },
    "humanSpotCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "subjects", "agreed"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "subjects": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "type": "string", "minLength": 1 } },
        "agreed": { "type": "boolean" },
        "comment": { "type": "string" }
      }
    }
  }
}
