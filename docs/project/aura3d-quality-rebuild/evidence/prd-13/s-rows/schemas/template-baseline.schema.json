{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura3d.prd13.s-record.template-baseline/1",
  "title": "13-BASE template baseline record (19 v3.0.1 templates x 3 shots x 2 viewports, flags none)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "row", "runId", "runUrl", "workflow", "job", "branch", "provider", "headSha", "recordedAt", "sourceRef", "sourceRefCommit", "flags", "reportPath", "reportSha256", "baselineDir", "templates", "summary", "round0"],
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "string" },
    "kind": { "const": "template-baseline" },
    "row": { "const": "13-BASE" },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runUrl": { "type": "string", "pattern": "^https://github\\.com/auraoneai/aura3d/actions/runs/[1-9][0-9]*" },
    "workflow": { "const": ".github/workflows/template-lookdev.yml" },
    "job": { "const": "capture" },
    "branch": { "const": "main" },
    "provider": { "const": "github-macos-14" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "sourceRef": { "const": "v3.0.1" },
    "sourceRefCommit": { "const": "3cfdb423af1e51867bab0dd438b8c937ec097fb2" },
    "flags": { "const": "none" },
    "reportPath": { "const": "benchmarks/agent-eval/baseline/templates/report.json" },
    "reportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "baselineDir": { "const": "benchmarks/agent-eval/baseline/templates/" },
    "templates": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "shots"],
        "properties": {
          "template": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "shots": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["shot", "viewport", "file", "sha256"],
              "properties": {
                "shot": { "enum": ["opening", "mid", "action"] },
                "viewport": { "enum": ["desktop-1920x1080", "mobile-390x844"] },
                "file": { "type": "string", "pattern": "\\.png$" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["templatesCaptured", "shotsExpected", "shotsCaptured", "failures"],
      "properties": {
        "templatesCaptured": { "const": 19 },
        "shotsExpected": { "const": 114 },
        "shotsCaptured": { "const": 114 },
        "failures": { "const": 0 }
      }
    },
    "round0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "workflow", "path", "sha256"],
      "properties": {
        "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "workflow": { "const": ".github/workflows/agent-output-eval.yml" },
        "path": { "type": "string", "pattern": "round-0\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
