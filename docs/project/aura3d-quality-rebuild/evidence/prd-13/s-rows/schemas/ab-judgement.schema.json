{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura3d.prd13.s-record.ab-judgement/1",
  "title": "13-S1/S2/S3 judgement record: blind A/B vs v3.0.1 baselines (S1), game-template absolute panel (S2), prompt-plan frame judgement (S3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "row", "mode", "runId", "runUrl", "workflow", "job", "branch", "provider", "headSha", "recordedAt", "baselineRunId", "rubric", "blind", "judges", "entries", "summary"],
  "properties": {
    "$schema": { "type": "string" },
    "notes": { "type": "string" },
    "kind": { "const": "ab-judgement" },
    "row": { "enum": ["13-S1", "13-S2", "13-S3"] },
    "mode": { "enum": ["ab", "absolute"] },
    "runId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "runUrl": { "type": "string", "pattern": "^https://github\\.com/auraoneai/aura3d/actions/runs/[1-9][0-9]*" },
    "workflow": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9-]+\\.yml$" },
    "job": { "type": "string", "minLength": 1 },
    "branch": { "const": "main" },
    "provider": { "const": "github-macos-14" },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T" },
    "baselineRunId": {
      "description": "13-BASE capture run id the A side comes from; null only for mode=absolute",
      "type": ["string", "null"],
      "pattern": "^[1-9][0-9]*$"
    },
    "rubric": { "type": "string", "minLength": 1, "description": "Rubric file + version used (e.g. references/quality-bar.md@<sha>)" },
    "blind": { "type": "boolean" },
    "panelTool": { "type": "string", "description": "G5 panel tooling id/version that produced the packet" },
    "judges": {
      "type": "array",
      "minItems": 2,
      "contains": { "type": "object", "required": ["type"], "properties": { "type": { "const": "human" } } },
      "minContains": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name"],
        "properties": {
          "type": { "enum": ["vision", "human"] },
          "name": { "type": "string", "minLength": 1 },
          "model": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "frame", "judge", "categories"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "frame": { "type": "string", "pattern": "\\.png$" },
          "frameSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "baselineFrame": { "type": ["string", "null"] },
          "judge": { "type": "string", "minLength": 1 },
          "categories": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "score"],
              "properties": {
                "category": { "type": "string", "minLength": 1 },
                "baselineScore": { "type": ["number", "null"], "minimum": 0, "maximum": 10 },
                "score": { "type": "number", "minimum": 0, "maximum": 10 }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjects", "median", "min", "medianGain", "maxCategoryDrop"],
      "properties": {
        "subjects": { "type": "integer", "minimum": 1 },
        "median": { "type": "number" },
        "min": { "type": "number" },
        "medianGain": { "type": ["number", "null"] },
        "maxCategoryDrop": { "type": ["number", "null"] },
        "categoryMedians": { "type": "object" }
      }
    }
  }
}
