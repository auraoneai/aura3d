examples/neon-corridor-strike/public/aura-assets/*.glb filter=lfs diff=lfs merge=lfs -text
# Root typed-asset blobs and glTF fixtures are binary and multi-MB. Tracking them in LFS
# keeps the git pack small enough to push: a ~40MB blob payload in a single pack was
# reproducibly rejected mid-transfer by the remote.
public/aura-assets/*.glb filter=lfs diff=lfs merge=lfs -text
public/aura-assets/heatsink*.glb -filter -diff -merge binary
public/aura-assets/teleop*.glb -filter -diff -merge binary
public/aura-assets/*.wav filter=lfs diff=lfs merge=lfs -text
public/aura-assets/*.ogg filter=lfs diff=lfs merge=lfs -text
apps/showcase-*/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
apps/showcase-*/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
# Isolated art-review GLBs can be large even when they are rejected before the
# shared typed catalog; keep their reproducible evidence out of the Git pack.
apps/showcase-*/art-review/**/*.glb filter=lfs diff=lfs merge=lfs -text
apps/showcase-*/art-review/external-source/**/*.png filter=lfs diff=lfs merge=lfs -text
# Route-local glTF source buffers are binary even when they are retained only
# for isolated art review and provenance reproduction.
apps/showcase-*/art-review/**/*.bin binary
assets/source/**/*.glb filter=lfs diff=lfs merge=lfs -text
tests/fixtures/**/*.glb filter=lfs diff=lfs merge=lfs -text
# Flagship glTF corpus fixtures resolved by CurrentRoutes/WOW routes. These are
# multi-MB binaries served to the browser at test time, so remote CI must receive
# real bytes: a missing file is fetched as an HTML 404 body and surfaces as
# "Invalid GLB magic" rather than as a clear missing-asset error.
fixtures/asset-corpus/*.glb filter=lfs diff=lfs merge=lfs -text

# Quality-gate goldens + evidence PNGs are binary and change as goldens are
# re-admitted; LFS keeps clone size stable (PRD-12 T3.2).
benchmarks/quality-rebuild/goldens/**/*.png filter=lfs diff=lfs merge=lfs -text
benchmarks/quality-rebuild/refs/**/*.png filter=lfs diff=lfs merge=lfs -text

# Pinned HDRI corpus payloads must stay in LFS, including the 8k starfield.
fixtures/environment-corpus/hdri/*.hdr filter=lfs diff=lfs merge=lfs -text
apps/showcase-*-v2/public/aura-assets/*.glb -filter -diff -merge binary

