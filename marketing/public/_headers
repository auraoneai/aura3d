/assets/*
  Cache-Control: public, max-age=31536000, immutable

/aura-assets/*
  Cache-Control: public, max-age=31536000, immutable

/aura-assets/*.glb
  Content-Type: model/gltf-binary

/hdri/*.hdr
  Content-Type: application/octet-stream

# Keep build-health artifacts and preview source plates out of the index.
/apps/*/route-health.json
  X-Robots-Tag: noindex

/previews/source/*
  X-Robots-Tag: noindex
