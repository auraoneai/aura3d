      "published": true,
      "releaseClass": "prototype-blocked",
      "primaryAssets": ["showcaseWalkAnimatedGirl", "showcaseSideScrollerWorld"],
      "primaryAssetRoles": {
        "showcaseWalkAnimatedGirl": "character",
        "showcaseSideScrollerWorld": "world"
      },
      "routePrimaryHeroAsset": "showcaseWalkAnimatedGirl",
      "secondaryPrimaryAssets": ["showcaseSideScrollerWorld"],
      "primitiveBudget": 24,
      "requiresTypedPrimaryAssets": true,
      "requiresKeyboardDelta": true,
      "gameTemplateStatus": {
        "category": "platformer",
        "publicTemplateReady": false,
        "blocker": "asset-pair:platformer-public-character-world-binding-missing",
        "requiredBeforePublic": [
          "select or certify a platformer world asset with mesh-derived playable surfaces",
          "prove character foot contact is visibly bound to retained platform surface evidence",
          "prove character/world scale and camera framing from the current retained screenshot",
          "pass public platformer visual review from the current retained screenshot"
        ],
        "evidence": [
          "aura3d-game-examples-stop-decision.md records the NO decision for current engine APIs and asset catalog",
          "tests/reports/showcase-spec-compiler/skyline-runner/game-template/showcase-skyline-runner-platformer-playable-surfaces.json retains hash-bound but non-public-quality playable-surface evidence",
          "tests/fixtures/showcase-spec/skyline-runner.json records failing platformer asset-pair evidence for the current screenshot",
          "docs/project/showcase-visual-review.json blocks public platformer visual approval"
        ]
      },
      "requiresAnimationSubjectDelta": true,
      "animationSubjectDelta": {
        "relativeCrop": { "x": 0.34, "y": 0.34, "width": 0.22, "height": 0.3 },
        "minChangedRatio": 0.035,
        "minStrongChangedRatio": 0.015,
        "minMeanChannelDelta": 1.2
      }
    },
