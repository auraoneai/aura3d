    {
      "feature": "WebGPU backend opt-in (renderer.backend \"webgpu\" / qualityProfile \"experimental-webgpu\")",
      "why": "ACR containers have no GPU adapter; native-gpu-render-compute (webgpu-before / webgpu-after) reports unsupported or software no-data, and a WebGPU frame would equal the WebGL2 frame anyway. If native-gpu emits the two PNG attachments they can be added as a spec-attachment view."
    },
    {
      "feature": "reversed / logarithmic camera depth",
      "why": "visible only in a far-plane z-fighting scene; native-camera-depth checks numbers, not a presentable frame, and no existing scene shows the difference."
    },
    {
      "feature": "weighted order-independent transparency, clipping planes, per-view velocity/temporal reconstruction",
      "why": "native-transparency, native-clipping and native-temporal-reconstruction evaluate fixtures on 32x32-class canvases and attach no frames."
    },
    {
      "feature": "Gaussian splats and scalar volumes (experimental)",
      "why": "native-splats-volume builds numeric fixtures and attaches no frame; there is no example scene."
    },
