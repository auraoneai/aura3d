{
  "name": "@aura3d/showcase-siege-golf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aura3D Siege Golf prototype: rigid-body physics as gameplay - golf shots topple jointed structures into sensor cup zones across nine authored holes.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:course-world": "node scripts/build-course-world.mjs",
    "build:sfx": "node scripts/build-sfx.mjs",
    "write:performance": "tsx --tsconfig ../../tsconfig.base.json scripts/write-performance-report.ts",
    "write:route-health": "node scripts/write-route-health.mjs"
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  }
}
