    "test:browser": "playwright test",
    "test:route-health": "playwright test tests/route-health.spec.ts"
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
