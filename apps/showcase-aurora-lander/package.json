{
  "name": "@aura3d/showcase-aurora-lander",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Precision polar descent showcase built on @aura3d/engine createGame with 3-site progression, deterministic wind, graded touchdown evaluation, and ghost replay.",
  "scripts": {
    "dev": "vite --port 4189",
