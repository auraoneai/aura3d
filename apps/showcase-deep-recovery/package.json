{
  "name": "@aura3d/showcase-deep-recovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aura3D flagship route: Deep Recovery — pelagic salvage submersible on the single-path createGame runtime with admitted GLB hulls, crates, wrecks, and surface recovery buoy.",
  "scripts": {
    "dev": "vite --port 5188",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "register:assets": "node scripts/register-assets.mjs",
    "assets:validate": "aura3d assets validate",
    "assets:typegen": "aura3d assets typegen",
    "check:deploy": "aura3d check-deploy",
    "test:route": "playwright test tests/route-health.spec.ts",
    "test:game": "playwright test tests/playable.spec.ts",
    "test:smoke": "pnpm run test:route && pnpm run test:game"
  },
  "dependencies": {
    "@aura3d/assets": "workspace:*",
    "@aura3d/core": "workspace:*",
    "@aura3d/engine": "workspace:*",
    "@aura3d/physics": "workspace:*"
  },
  "devDependencies": {
    "@aura3d/cli": "workspace:*",
    "@playwright/test": "^1.52.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
