{
  "name": "Aura Clash 2.0 launch evidence manifest",
  "version": "2.0.0",
  "documentation": "../../docs/examples/aura-clash.md",
  "purpose": "Defines the read-only evidence and explicit human approval gates for the Aura Clash 2.0 showcase.",
  "remainingHumanGate": {
    "checkbox": "Visual screenshot approved by user.",
    "requiredEvidence": [
      "apps/aura-clash-showcase/launch-evidence/first-frame.png",
      "apps/aura-clash-showcase/launch-evidence/first-frame.json",
      "apps/aura-clash-showcase/launch-evidence/review-package.md",
      "apps/aura-clash-showcase/launch-evidence/visual-approval.json"
    ],
    "automationRule": "No automation may grant visual approval. record-visual-approval.mjs may persist approval only after explicit human confirmation and binds it to exact artifact hashes."
  },
  "sourceEvidence": {
    "launchGlbProvenance": {
      "files": [
        "apps/aura-clash-showcase/assets/source/aura-clash-launch-asset-evidence.json",
        "apps/aura-clash-showcase/aura.assets.json",
        "apps/aura-clash-showcase/scripts/check-production-assets.mjs"
      ],
      "proves": ["Typed fighter and arena assets have provenance, validation, and no primitive fallback."]
    },
    "gameRuntimeEvidence": {
      "files": [
        "packages/engine/src/agent-api/GameEvidence.ts",
        "packages/engine/src/agent-api/GameRuntime.ts",
        "apps/aura-clash-showcase/src/main.ts"
      ],
      "proves": ["The public game runtime exposes the evidence consumed by the showcase."]
    },
    "stageSafeZone": {
      "files": [
        "packages/engine/src/agent-api/game-kits/fighting.ts",
        "apps/aura-clash-showcase/src/playable/arena/AuraClashArenaStage.ts"
      ],
      "proves": ["Combat bounds, camera-safe layers, and stage validation are implemented in source."]
    },
    "treeShakableExports": {
      "files": [
        "packages/engine/src/agent-api/GameRuntime.ts",
        "packages/engine/src/agent-api/index.ts",
        "docs/examples/fighting-game.md"
      ],
      "proves": ["AuraClash uses public named exports and typed assets."]
    }
  },
  "commands": {
    "localGates": {"command":"npm run launch:local-gates","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/local-gates.json"},
    "firstFrameScreenshot": {"command":"npm run launch:screenshot","cwd":"apps/aura-clash-showcase","outputs":["apps/aura-clash-showcase/launch-evidence/first-frame.png","apps/aura-clash-showcase/launch-evidence/first-frame.json"]},
    "vercelDeploy": {"command":"npm run launch:deploy","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/vercel-deploy.json"},
    "deployedRouteEvidence": {"command":"npm run launch:evidence","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/deployed-routes.json"},
    "auraClashEvidence": {"command":"npm run flagship:gates","cwd":"apps/aura-clash-showcase","outputs":["apps/aura-clash-showcase/tests/reports/flagship-gates.json","apps/aura-clash-showcase/tests/reports/flagship-readiness.json"]},
    "reviewPackage": {"command":"npm run launch:review-package","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/review-package.md"},
    "visualApproval": {"command":"npm run launch:approve-visual","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/visual-approval.json"},
    "crossRuntimeEvidence": {"command":"npm run launch:cross-runtime-evidence","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/cross-runtime-evidence.json"},
    "documentationEvidence": {"command":"npm run launch:documentation-evidence","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/documentation-evidence.json"},
    "commandPlanCheck": {"command":"npm run launch:command-plan-check","cwd":"apps/aura-clash-showcase","inputs":["apps/aura-clash-showcase/launch-evidence.command-plan.json"]},
    "commandPlanDryRun": {"command":"npm run launch:command-plan","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/command-plan-run.json"},
    "evidenceWiringCheck": {"command":"npm run launch:wiring-check","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/evidence-wiring.json"},
    "readinessReport": {"command":"npm run launch:readiness","cwd":"apps/aura-clash-showcase","outputs":["apps/aura-clash-showcase/launch-evidence/readiness.json","apps/aura-clash-showcase/launch-evidence/readiness.md"]},
    "documentationAudit": {"command":"npm run launch:documentation-check","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/documentation-audit.json"},
    "proofWorkflow": {"command":"npm run launch:proof","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/workflow.json"},
    "localProofAlias": {"command":"npm run launch:proof-local","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/workflow.json"},
    "completeProofAlias": {"command":"npm run launch:proof-complete","cwd":"apps/aura-clash-showcase","output":"apps/aura-clash-showcase/launch-evidence/workflow.json"}
  },
  "boundary": "Machine evidence may prove implementation and artifact wiring. Deployment requires deployed-route evidence; visual approval requires an explicit human decision bound to exact pixels."
}
