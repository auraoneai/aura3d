{
  "name": "Aura Clash 2.0 documentation evidence map",
  "version": "2.0.0",
  "documentation": "../../docs/examples/aura-clash.md",
  "output": "launch-evidence/documentation-evidence.json",
  "purpose": "Maps the current Aura Clash 2.0 documentation to durable machine evidence while keeping human visual approval explicit.",
  "rules": [
    {
      "id": "flagship-gates",
      "kind": "machine-evidence",
      "requiredArtifacts": [
        "apps/aura-clash-showcase/tests/reports/flagship-gates.json",
        "apps/aura-clash-showcase/tests/reports/flagship-readiness.json"
      ]
    },
    {
      "id": "visual-review",
      "kind": "human-review-input",
      "requiredArtifacts": [
        "apps/aura-clash-showcase/launch-evidence/first-frame.json",
        "apps/aura-clash-showcase/launch-evidence/review-package.md"
      ]
    },
    {
      "id": "claim-boundary",
      "kind": "documentation",
      "requiredArtifacts": [
        "docs/examples/aura-clash.md",
        "docs/agents/claims-and-boundaries.md"
      ]
    }
  ]
}
