{
  "name": "@aura3d/showcase-vault-breakers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aura3D Vault Breakers prototype: neon pinball with player-actuated motorised flipper joints, five target banks, a vault multiball, and an in-world extruded-text scoreboard.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "build:sfx": "node scripts/build-sfx.mjs",
    "build:models": "node scripts/build-models.mjs",
    "register:assets": "node scripts/register-assets.mjs",
    "write:performance": "pnpm exec tsx --tsconfig ../../tsconfig.base.json scripts/write-performance-report.ts",
    "write:deploy": "node scripts/write-deploy-report.mjs",
    "write:route-health": "node scripts/write-route-health.mjs"
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  }
}
