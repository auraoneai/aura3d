{
  "name": "@aura3d/showcase-neon-swarm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aura3D Neon Swarm: single-path five-wave top-down horde-survival run on the salvaged gameplay core (arena, swarm, waves, player, pickups, run) with createGame, instanced grunt/elite drone pools, and typed courier/barricade/lamp assets.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "vite build",
    "build-sfx": "node scripts/build-sfx.mjs",
    "register-sfx": "node scripts/register-sfx.mjs",
    "register-models": "node scripts/register-models.mjs",
    "evidence:route-health": "node scripts/write-route-health.mjs",
    "evidence:performance": "tsx scripts/write-performance-report.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vite": "^7.3.2"
  }
}
