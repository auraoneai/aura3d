{
  "name": "@aura3d/wonder-world",
  "version": "4.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:published": "tsc -p tsconfig.published.json --noEmit",
    "build": "vite build",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "echo 'Browser specs run on the remote runner: SPECS=\"tests/browser/wonder-world-*.spec.ts\" tools/remote-acr/run.sh (from the repo root)'",
    "validate:content": "node tools/validate-wonder-world-content.mjs"
  },
  "dependencies": {
    "@aura3d/engine": "workspace:*",
    "@aura3d/debug": "workspace:*",
    "@aura3d/audio": "workspace:*"
  }
}
