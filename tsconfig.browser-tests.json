{
  "extends": "./tsconfig.base.json",
  // Source-only check for the native roadmap's browser specs and their
  // separately served TypeScript harnesses. It does not run a browser or
  // claim that the older browser suite has been typechecked.
  "compilerOptions": {
    "noEmit": true,
    // Browser specs iterate DOM collections (HTMLCollection, NodeList).
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "tests/browser/native-*.ts",
    // Native roadmap spec + harness inside the prd04 browser tree (that tree is
    // excluded from tsconfig.check.json for its dev-server absolute URLs; these
    // two import none).
    "tests/qr/prd04/browser/native-physical-numeric.spec.ts",
    "tests/qr/prd04/browser/native-physical-numeric.ts",
    "tests/browser/editor-authoring-external-parity.spec.ts",
    "tests/browser/example-dev-server.ts",
    "tests/browser/createAuraApp-animation-bridge-harness.ts",
    "tests/browser/input-browser-harness.ts",
    "tests/browser/root-sdf-text-g1-harness.ts",
    "tests/browser/resource-soak-u1.spec.ts",
    "tests/browser/resource-soak-u1-harness.ts",
    "tests/browser/resource-soak-accounting.ts",
    "tests/visual/canvas-pixel-checks.ts"
  ],
  "exclude": ["node_modules", "dist", "tests/**/fixtures/**"]
}
