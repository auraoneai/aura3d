  "observations": [
    {
      "category": "lighting",
      "seen": "Every world is overexposed: mean luma 225-241 of 255 and p5 above 170, so the pastel ground and sky wash to near white."
    },
    {
      "category": "shadows",
      "seen": "Contact shadows under Momo and Sheru are faint grey smudges against the washed-out ground."
    },
    {
      "category": "ibl_reflections",
      "seen": "Matte clay materials show little image-based response; acceptable for the style but flat."
    },
    {
      "category": "environment_world",
      "seen": "The learning cloud is a white field with white cloud banks: almost no figure-ground separation (colourfulness 5-6)."
    },
    {
      "category": "atmospheric_effects",
      "seen": "The thinned look fog adds a uniform pale haze over the whole meadow."
    },
    {
      "category": "material_quality",
      "seen": "The red ball reads salmon and the green bushes read mint: saturation is lost to exposure (mean saturation 0.02-0.13)."
    },
    {
      "category": "composition",
      "seen": "Characters stand small in the middle third with the lower third empty ground."
    },
    {
      "category": "camera",
      "seen": "The wide child camera holds the whole stage but sits far back for a toddler's eye."
    },
    {
      "category": "postprocessing",
      "seen": "The preset grade lifts the already bright frame further; highlights clip toward white."
    }
  ],
  "nextChange": {
