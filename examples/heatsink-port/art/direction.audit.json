    "references": [
      {
        "file": "references/blue-hour-canyon.json",
        "source": "generic reference: desert canyon photographed in the twenty minutes after sunset (violet zenith, warm band on the horizon)",
        "licence": "reference-only",
        "why": "The two-tone twilight sky the dome reproduces: a magenta-to-amber band at the sun azimuth under a violet zenith, rock lit from the sky"
      },
      {
        "file": "references/anti-gravity-racer.json",
        "source": "shipped comparable: anti-gravity racing presentation (WipEout HD / Redout chase framing and engine trails)",
        "licence": "reference-only",
        "why": "Low chase camera, bank roll on corners and a coloured engine wake that reads speed and boost state at a glance"
      },
      {
        "file": "references/wet-obsidian.json",
        "source": "generic reference: polished black volcanic glass and wet basalt reflecting a coloured sky",
        "licence": "reference-only",
        "why": "A dark glossy road that mirrors the sky at grazing angles (fresnel) so the causeway is bright at the horizon and dark underfoot"
      },
      {
        "file": "references/bioluminescent-mineral.json",
