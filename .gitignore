!.travis.yml
!.circleci/

# Keep package manager files
!package.json
!pnpm-lock.yaml
!tsconfig.json
!.npmrc
!.pnpmfile.cjs
.vercel

# Local Meshy candidates and operational task state (admitted public assets are not ignored)
artifacts/meshy/**
