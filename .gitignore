# ============================================================================
# Project Specific
# ============================================================================

# Build artifacts
*.wasm
*.wasm.map
!marketing/public/assets/draco/*.wasm
release-artifacts/external-demos/

# Generated files
*.generated.ts
*.generated.js
# Resolution maps are generated but committed (PRD-15 T1.2): fresh checkouts
# and CI must resolve them without running the generator first.
!vite.aliases.generated.ts
!tsconfig.paths.generated.ts

# Shader compilation cache
shader-cache/
*.spv
*.spv.json

# Asset pipeline cache
asset-cache/
*.assetcache

# Performance profiles
profiles/
*.profile.json

# Benchmark results
benchmarks/results/
*.benchmark.json

# Local test data
test-data/
*.testdata

# Editor backups
*~
.#*

# ============================================================================
# Large Binary Assets & Generated Files
# ============================================================================

*.png
*.jpg
*.jpeg
*.gif
*.csv

# GLB sidecar textures are runtime source dependencies and must travel with snapshots.
!public/aura-assets/Textures/
!public/aura-assets/Textures/*.png

fixtures/
# PRD-15 lane fixtures (codemod inputs/outputs, C-30 lean template scenes).
!tests/qr/prd15/fixtures/
# Lane test fixtures that unit/contract tests read (prd03 .cube LUTs, prd05
# route-bundle + codemod inputs) and the camera-cast codemod fixtures.
!tests/qr/prd03/fixtures/
!tests/qr/prd05/fixtures/
!tools/camera-cast-codemod/fixtures/
# Lane-owned reference-game fixtures (PRD-09 §10) are tracked sources.
!packages/game/fixtures/
!packages/game/fixtures/**
# Immutable, hash-bound showcase compiler specs and evidence.
!tests/fixtures/
# PRD-09 lane-09 owns packages/game/fixtures/ (route fixture code for specs).
!packages/game/fixtures/
!tests/fixtures/showcase-spec/
!tests/fixtures/showcase-spec/**
# QR lane fixtures are tracked source (PRD-06 T0.9a tests/qr/prd06/fixtures/).
!tests/qr/prd06/fixtures/
# The fixture allow-list above must not re-include macOS metadata.
tests/fixtures/showcase-spec/**/.DS_Store

# ============================================================================
# Keep These (Don't Ignore)
# ============================================================================

# Keep example configs
!*.example.json
!*.example.ts
!*.example.js

# Keep documentation
!docs/**/*.md
!README.md
!CHANGELOG.md
!LICENSE

