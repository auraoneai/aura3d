{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@aura3d/engine": ["../../dist/engine/public/index.d.ts"],
      "@aura3d/engine/game": ["../../dist/game/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
